# Copy to site.config (gitignored) and edit. Environment variables of the
# same name override this file.

# Public origin of the site, no trailing slash. Leave empty to omit the
# canonical link.
SITE_URL=

# Address shown in the footer. Use a real, existing address (the studio has a
# support@ one); do not make up others.
CONTACT_EMAIL=support@example.com

# Optional link on the team member's name. Leave empty for plain text.
TEAM_MASON_URL=
